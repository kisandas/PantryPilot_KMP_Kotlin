<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" initialViewController="launch">
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="1.0"/></dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="background">
                        <rect key="frame" x="0" y="0" width="390" height="844"/>
                        <subviews>
                            <imageView contentMode="scaleAspectFit" image="PantryLogo" translatesAutoresizingMaskIntoConstraints="NO" id="logo">
                                <rect key="frame" x="147" y="374" width="96" height="96"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="logo-width"/>
                                    <constraint firstAttribute="height" constant="96" id="logo-height"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.980" green="0.973" blue="0.941" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="logo" firstAttribute="centerX" secondItem="background" secondAttribute="centerX" id="center-x"/>
                            <constraint firstItem="logo" firstAttribute="centerY" secondItem="background" secondAttribute="centerY" id="center-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources><image name="PantryLogo" width="512" height="512"/></resources>
</document>
